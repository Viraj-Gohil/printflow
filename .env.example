# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-only PostgreSQL connection string (Neon or Supabase). Never prefix with VITE_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
PRINTFLOW_LEGACY_SHOP_ID="shop_shree_ganesh"
PRINTFLOW_NEON_SHOP_ID="YOUR_NEON_SHOP_ID"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay API Credentials
RAZORPAY_KEY_ID="rzp_live_TmtCNk0tJgUAQP"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
VITE_RAZORPAY_KEY_ID="rzp_live_TmtCNk0tJgUAQP"
